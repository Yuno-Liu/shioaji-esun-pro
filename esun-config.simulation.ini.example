# esun-config.simulation.ini.example — 玉山證券 (E.Sun Securities) 測試/模擬環境設定檔範本
#
# 使用方式：
# 1. 將此檔案複製為 `esun-config.simulation.ini`（或支援的別名 `esun-config.sim.ini`）。
# 2. 填寫玉山證券測試環境核發之 API 金鑰與帳號。
# 3. 測試環境 Entry 固定為：
#      Entry = https://esuntradingapi-simulation.esunsec.com.tw/api/v1
#      Environment = SIMULATION
# 4. 密碼請透過環境變數傳入：
#      ESUN_ACCOUNT_PASSWORD=您的玉山證券登入密碼 (或 ESUN_PASSWORD)
#      ESUN_CERT_PASSWORD=您的憑證密碼 (.p12)

[Core]
Entry = https://esuntradingapi-simulation.esunsec.com.tw/api/v1
Environment = SIMULATION

[Cert]
# 憑證路徑 (.p12 檔案)
Path = certs/esun_cert.p12

[Api]
# 玉山證券測試環境 API 金鑰 (Key) 與密鑰 (Secret)
Key = YOUR_SIMULATION_API_KEY_HERE
Secret = YOUR_SIMULATION_API_SECRET_HERE

[User]
# 證券帳號 (支援 11 碼或 7 碼)
Account = 88401234567

[Server]
Host = 127.0.0.1
Port = 8090
