# ─────────────────────────────────────────────────────────────────────────────
# Shioaji Pro Web — Docker 一鍵部署環境變數設定範本 (.env.docker.example)
#
# 使用方式：
# 1. 複製此檔案為 `.env`（一鍵部署腳本會自動複製）：
#      cp .env.docker.example .env (Linux / macOS)
#      Copy-Item .env.docker.example .env (PowerShell)
# 2. 填寫下方玉山證券登入密碼與憑證密碼。
# 3. 確保已將玉山憑證 (.p12) 放入 `./certs/` 目錄，並配置 `esun-config.simulation.ini`
#    / `esun-config.production.ini`（或單一 `esun-config.ini`）。
# 詳細說明：docs/fork/esun.md
# ─────────────────────────────────────────────────────────────────────────────

# ── 對外存取（安全預設：只有本機可連） ──────────────────────────────────────
# Web 終端在主機上綁定的位址與埠號（預設 http://127.0.0.1:8080）。
# 警告：不要把 8080/8090 暴露到區網。若真的需要區網存取，請同時：
#   1) WEB_BIND=0.0.0.0（或指定網卡 IP）
#   2) WEB_SERVER_NAMES 填入區網使用的主機名稱或 IP（以空白分隔）
#   3) 啟用 WEB_BASIC_AUTH 並掛載 htpasswd（見 docs/fork/esun.md）
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Nginx 容器內部監聽埠號 (預設 8080，通常無須修改)
PORT=8080

# 允許的額外 Host 名稱（nginx server_name 與橋接 Host 白名單共用；以空白分隔）
WEB_SERVER_NAMES=

# Basic Auth（off 表示停用；啟用時填 realm 名稱，例如 ShioajiPro）
WEB_BASIC_AUTH=off

# nginx 存取玉山橋接用的共享 token（橋接要求，瀏覽器不持有）。
# 留空時一鍵部署腳本會自動產生 32 bytes 隨機值寫入 .env（不顯示於畫面）。
ESUN_BRIDGE_TOKEN=

# 永豐金證券 Shioaji API 上游位址
# 預設指向容器內建的 shioaji-server (127.0.0.1:21322)；若改用本機啟動則設為 http://host.docker.internal:21322
SHIOAJI_API_UPSTREAM=http://127.0.0.1:21322

# 玉山證券 Sidecar 上游位址（結尾不要加斜線）
# 模式 A (全自動容器化模式，推薦)：
#   使用同 Docker Compose 網路內之 esun-bridge 容器 (Linux wheel 原生執行)；
#   esun-bridge 不發佈埠到主機，排錯請用：docker compose exec esun-bridge curl -s localhost:8090/esun/livez
ESUN_BRIDGE_UPSTREAM=http://esun-bridge:8090
#
# 模式 B (Windows 原生模式，使用 .\scripts\deploy-docker.ps1 -HostBridge)：
#   由腳本在 Windows 宿主機上啟動 Python esun_trade_server.py（預設只綁 127.0.0.1），
#   容器內 Nginx 透過 host.docker.internal 反向代理至 Windows 本地服務
# ESUN_BRIDGE_UPSTREAM=http://host.docker.internal:8090

# 玉山設定檔所在的主機目錄（唯讀掛載進橋接容器；預設為專案根目錄）
# ESUN_CONFIG_HOST_DIR=.

# 玉山證券帳號登入密碼 (或 ESUN_PASSWORD)
# 注意：輸錯 3 次將觸發玉山官方鎖帳 (AGA0000)，請務必確認密碼無誤！
ESUN_ACCOUNT_PASSWORD=

# 玉山證券憑證密碼 (.p12 憑證保護密碼)
ESUN_CERT_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# 永豐金證券 (SinoPac Shioaji) API 金鑰設定（提供即時行情與永豐交易）
# 申請金鑰網址：https://www.sinotrade.com.tw/newweb/PythonAPIKey/
# ─────────────────────────────────────────────────────────────────────────────
SJ_API_KEY=
SJ_SEC_KEY=

# 是否啟用永豐正式環境（預設 false：使用永豐模擬模式即可免費取得完整即時行情，由玉山證券負責正式下單）
SJ_PRODUCTION=false

# （選填）若需使用永豐證券帳號下單，請將永豐 .pfx 憑證放入 ./certs/ 並填寫下方路徑與密碼：
# SJ_CA_PATH=/app/certs/Sinopac.pfx
# SJ_CA_PASSWD=
