# Shioaji Pro Web — nginx 反向代理模板（官方映像啟動時以 envsubst 產生 conf.d/default.conf）
# 只有名稱符合 NGINX_ENVSUBST_FILTER 且已定義的環境變數會被替換；
# 小寫的 $host、$http_origin 等是 nginx 變數，不會被 envsubst 動到。

# 跨來源防護：Origin 必須與 Host 相同（不比 scheme，方便前面再接 TLS 代理），
# 沒有 Origin（curl、同源 GET）則放行；Origin 為 null 或其他網站一律視為跨來源。
map "$http_origin|$http_host" $shioaji_pro_cross_origin {
    default 1;
    "~^\|" 0;
    "~*^https?://([^/|]+)\|\1$" 0;
}

# 瀏覽器的 Sec-Fetch-Site：只接受同源或使用者直接開啟（none）；沒有此標頭（非瀏覽器）放行
map $http_sec_fetch_site $shioaji_pro_cross_site {
    default 1;
    "" 0;
    same-origin 0;
    none 0;
}

# /api/ 的寫入請求只接受 JSON（縱深防禦：sidecar 自己的跨來源檢查會因 Host 改寫而失效）。
# GET／HEAD 不檢查；DELETE 沒有 body 時沒有 Content-Type，放行。前端（src/lib/api.ts）的 POST／PUT 一律帶
# application/json，DELETE 有 body 時也是。其他（表單、text/plain、沒有 Content-Type 的 POST）回 415。
map "$request_method:$content_type" $shioaji_pro_api_bad_type {
    default 1;
    "~^(GET|HEAD):" 0;
    "~*^(POST|PUT|DELETE):application/json\s*(;.*)?$" 0;
    "DELETE:" 0;
}

# HSTS 只送給 Tailscale 的 *.ts.net 主機名（一定經 HTTPS 前端開啟）；$host 已是小寫且不含 port。
# 不加 includeSubDomains／preload；localhost、區網 http://trade.lan:8080 等主機為空字串，
# 空值的 add_header 不會送出，避免把只走 HTTP 的主機名強制升級成 HTTPS 而連不上。
map $host $shioaji_pro_hsts {
    default "";
    "~*\.ts\.net$" "max-age=31536000";
}

# 預設 server：Host 不在允許清單（例如 DNS rebinding、以 IP 從區網直連）一律斷線
server {
    listen ${PORT} default_server;
    server_name _;
    server_tokens off;
    return 444;
}

server {
    listen ${PORT};
    # 允許的 Host：本機 + WEB_SERVER_NAMES（以空白分隔，例如 "trade.lan 192.168.1.20"）
    server_name localhost 127.0.0.1 ${WEB_SERVER_NAMES};
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # 所有重新導向（/m、/esun、/api 的 301／302，以及目錄補斜線）的 Location 只送相對路徑：
    # 前面接 TLS 前端時不會被改寫成 http:// 或帶上容器內的 :8080
    absolute_redirect off;

    include /etc/nginx/snippets/security-headers.conf;

    # 選用的 Basic Auth：WEB_BASIC_AUTH 預設 off；要開放區網時設成任意 realm 名稱，
    # 並把 htpasswd 檔唯讀掛載到 /etc/nginx/auth/htpasswd（見 docs/fork/esun.md）
    auth_basic "${WEB_BASIC_AUTH}";
    auth_basic_user_file /etc/nginx/auth/htpasswd;

    # 執行期解析上游（由官方 entrypoint 依 /etc/resolv.conf 匯出），
    # esun-bridge 尚未啟動或 IP 改變時 nginx 仍可啟動，/esun/ 只回 502
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # Enable gzip compression for fast asset transfers
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript application/json application/javascript application/manifest+json application/rss+xml application/atom+xml image/svg+xml;

    # 容器 healthcheck（無副作用、免 Basic Auth）
    location = /healthz {
        auth_basic off;
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Dedicated HTML pages（不快取，重新部署後立即生效）
    location = /approval.html {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files /approval.html =404;
    }

    # 手機版短網址（選配）：/m → /mobile.html（相對 Location，見 server 層的 absolute_redirect off）。
    # 此 location 不自訂 add_header，安全標頭沿用 server 層級設定。
    location = /m {
        return 302 /mobile.html;
    }

    # 手機交易頁：不快取（同 location /），另加 COOP same-origin，
    # 由其他網站 window.open 開啟時切斷 opener 參照（防 tabnabbing）。有 add_header，安全標頭需再 include。
    location = /mobile.html {
        add_header Cache-Control "no-cache" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files /mobile.html =404;
    }

    # 手機版 PWA manifest（由 vite.fork.config.ts 產生，無雜湊）：明確以 application/manifest+json 提供，
    # 不依賴映像內 mime.types 是否收錄 .webmanifest（未收錄時會變成 application/octet-stream，
    # 搭配 nosniff 可能被瀏覽器忽略）。不快取；Basic Auth 照常套用（mobile.html 以 crossorigin="use-credentials" 取得）。
    # 此 location 有 add_header，安全標頭需再 include 一次。
    location = /mobile.webmanifest {
        types { }
        default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # 只有 Vite 產出的帶雜湊資產（vite.config.ts 設 assetsDir: ''，檔名形如 main-D_2YXx_3.js）
    # 才可長期快取；public/ 內無雜湊的檔案走下方 location / 的 no-cache。
    # rolldown 遇到同名同雜湊會在 8 碼雜湊後補一位數字（例如 vendor-CjBHE94L2.js），所以允許第 9 碼為數字；
    # 不可放寬成 {8,}，否則 apple-touch-icon.png、shioaji-mark-small.svg 會被誤判為長快取
    # （deploy/test_nginx_template.py 以實際建置輸出驗證）。
    # /api/、/esun/ 使用 ^~，不會被這個 regex 搶先比對。
    location ~* "-[A-Za-z0-9_-]{8}[0-9]?\.(?:js|mjs|css|woff2?|ttf|png|jpe?g|gif|svg|webp|avif|ico|wasm)$" {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # Redirect /esun without trailing slash to /esun/
    location = /esun {
        return 301 /esun/;
    }

    # Reverse-proxy /esun/ to E.Sun Bridge Sidecar with full SSE streaming support
    location ^~ /esun/ {
        if ($shioaji_pro_cross_origin) {
            return 403;
        }
        if ($shioaji_pro_cross_site) {
            return 403;
        }
        # 玉山 driver（src/lib/esun/http-driver.ts）只送 GET、POST；其他方法在 nginx 就回 403。
        # body 上限與 bridge 相同（64 KiB），超過時 nginx 直接回 413、不轉送。
        limit_except GET POST {
            deny all;
        }
        client_max_body_size 64k;

        # proxy_pass 帶變數時不可再附 URI：原始的 /esun/... 路徑會原樣轉送
        set $esun_bridge_upstream ${ESUN_BRIDGE_UPSTREAM};
        proxy_pass $esun_bridge_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_next_upstream off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # 保留 port，供橋接比對 Origin 與 Host；token 由 nginx 注入（瀏覽器不持有），
        # 值為空時 nginx 不送出此標頭，也會移除客戶端自帶的同名標頭
        proxy_set_header Host $http_host;
        proxy_set_header X-Esun-Bridge-Token "${ESUN_BRIDGE_TOKEN}";
        # 不把 Basic Auth 帳密（Authorization）與瀏覽器 cookie 轉給上游（空值時 nginx 不送出此標頭）
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Redirect /api without trailing slash to /api/
    location = /api {
        return 301 /api/;
    }

    # Reverse-proxy /api/ to SinoPac Shioaji API Upstream with full SSE streaming support
    location ^~ /api/ {
        if ($shioaji_pro_cross_origin) {
            return 403;
        }
        if ($shioaji_pro_cross_site) {
            return 403;
        }
        if ($shioaji_pro_api_bad_type) {
            return 415;
        }
        # 前端只用 GET、POST、PUT、DELETE（src/lib/api.ts）；其他方法（PATCH、OPTIONS、TRACE…）回 403。
        # body 上限 256 KiB：最大的請求是自選清單同步（每檔約 60 bytes，可容納數千檔），委託 JSON 都在 1 KiB 內。
        limit_except GET POST PUT DELETE {
            deny all;
        }
        client_max_body_size 256k;

        proxy_pass ${SHIOAJI_API_UPSTREAM}/api/;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_next_upstream off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # Shioaji sidecar 只接受 loopback Host，且帶非本機 Origin 一律 403
        # （"Host is not a loopback address"／"cross-origin request to the local server"，1.7.10 實測）。
        # 以 WEB_SERVER_NAMES（區網、Tailscale／Caddy 的 HTTPS 主機名）開啟時，上面已由 nginx 檢查
        # Host 白名單、Origin 與 Host 相同、Sec-Fetch-Site；通過後轉給 sidecar 一律用本機 Host 並移除 Origin
        # （空值時 nginx 不送出此標頭）。本機開啟時 $host 本來就是 127.0.0.1，行為不變。
        proxy_set_header Host 127.0.0.1;
        proxy_set_header Origin "";
        # 不把 Basic Auth 帳密（Authorization）與瀏覽器 cookie 轉給第三方 sidecar
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 帳務、持倉 JSON 不留在瀏覽器 HTTP 快取（sidecar 自己帶什麼快取標頭不可靠）。
        # 有 add_header 就不繼承 server 層，安全標頭需再 include。
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # SPA routing fallback（index.html 與 public/ 內無雜湊的檔案一律重新驗證）
    location / {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
